# Server Port
PORT=5000

# Environment Mode (development or production)
NODE_ENV=production

# MongoDB Connection URI (e.g. MongoDB Atlas or self-hosted)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/petrol_pump_db?retryWrites=true&w=majority

# JWT Authentication Secret Key & Expiration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=30d

# Allowed CORS Origins (comma-separated for multiple origins, or * for all)
CORS_ORIGIN=*
